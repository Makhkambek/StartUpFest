# ──────────────────────────────────────────────────────────────────────────────
# SFRC Next.js env template — copy to .env.local for local dev, or paste into
# the GitLab CI variable `WEB_ENV` (File type) for production deploy.
#
#   cp .env.example .env.local
#   # then fill in the secrets below
# ──────────────────────────────────────────────────────────────────────────────

# ── Project ───────────────────────────────────────────────────────────────────
# Used as the container_name prefix in docker-compose. Must be unique per host.
PROJECT_NAME=sfrc-next
NODE_ENV=production
# Production domain (served via nginx on the host).
NEXT_PUBLIC_SITE_URL=https://robotics.startupfest.uz

# ── Supabase ──────────────────────────────────────────────────────────────────
# Leave blank for mock mode; set both to use the real Supabase backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
