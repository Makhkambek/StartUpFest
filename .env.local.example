NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry error tracking — get DSN from sentry.io → Settings → Projects → Client Keys
# If not set, Sentry is silently disabled and NO errors will be reported during the tournament.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# HMAC secret for mock-mode session cookies. Required in production (min 16 chars).
SESSION_SECRET=

# Judge account passwords (each >= 12 chars). Used only by:
#   npx tsx --env-file=.env.local scripts/seed-auth-users.ts
#   npx tsx --env-file=.env.local scripts/reset-passwords.ts
# Generate strong values: `openssl rand -base64 18`
SFRC_ADMIN_PASSWORD=
SFRC_JUDGE_A1_PASSWORD=
SFRC_JUDGE_A2_PASSWORD=
SFRC_JUDGE_B1_PASSWORD=
SFRC_JUDGE_B2_PASSWORD=
SFRC_JUDGE_C1_PASSWORD=
SFRC_JUDGE_C2_PASSWORD=
SFRC_JUDGE_D1_PASSWORD=
SFRC_JUDGE_D2_PASSWORD=
